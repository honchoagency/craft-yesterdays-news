{#
  Yesterday's News — JS beacon
  Injected via View::EVENT_END_BODY into all frontend page renders.
  This script tag is baked into the static HTML that Blitz caches, so it is
  present in every cached page response served to subsequent visitors.

  The track endpoint has CSRF validation disabled (it is a read-only analytics
  call), so no token handling is needed.

  The actionTrigger value is rendered once during the initial PHP page render
  and baked as a literal string into the cached static HTML.
#}
<script>
navigator.sendBeacon(
  '/{{ actionTrigger }}/yesterdays-news/track',
  new Blob([JSON.stringify({ url: window.location.pathname })], { type: 'application/json' })
);
</script>
