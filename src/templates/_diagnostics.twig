{#
  Yesterday's News — CP diagnostics utility
  Renders a table of the yesterdays_news_visits DB rows and a table of
  cached include candidates, annotated with prune status.
#}

<div class="yn-diagnostics">

  {# ── Blitz not installed notice ────────────────────────────────── #}
  {% if not blitzIsInstalled %}
    <div class="yn-notice">
      <span data-icon="alert"></span>
      <strong>Blitz is not installed.</strong>
      Yesterday's News requires the Blitz plugin to track and prune cached pages.
      Visit tracking and all prune operations are disabled.
    </div>
  {% endif %}

  {# ── Action buttons — these operate across every site, not just the one
       selected below, so they sit above the site switcher ─────────── #}
  <div class="yn-actions">

    <form method="post">
      {{ csrfInput() }}
      {{ actionInput('yesterdays-news/cp/flush') }}
      {{ redirectInput(craft.app.request.url) }}
      <button type="submit" class="btn{{ not blitzIsInstalled ? ' disabled' }}"{% if not blitzIsInstalled %} disabled{% endif %}>
        Flush buffer to DB{% if globalPendingCount > 0 %} <span class="badge">{{ globalPendingCount }}</span>{% endif %}
      </button>
    </form>

    <form method="post">
      {{ csrfInput() }}
      {{ actionInput('yesterdays-news/cp/prune') }}
      {{ redirectInput(craft.app.request.url) }}
      {% set pruneDisabled = not blitzIsInstalled or (globalStaleCount == 0 and globalIncludeReadyCount == 0) %}
      <button type="submit" class="btn submit{{ pruneDisabled ? ' disabled' }}"{% if pruneDisabled %} disabled{% endif %}>
        Prune
        {% if globalStaleCount > 0 %}{{ globalStaleCount }} stale URL{{ globalStaleCount != 1 ? 's' }}{% endif %}
        {% if globalStaleCount > 0 and globalIncludeReadyCount > 0 %} + {% endif %}
        {% if globalIncludeReadyCount > 0 %}{{ globalIncludeReadyCount }} stale include{{ globalIncludeReadyCount != 1 ? 's' }}{% endif %}
        {% if globalStaleCount == 0 and globalIncludeReadyCount == 0 %}0 stale{% endif %}
      </button>
    </form>

    <form method="post">
      {{ csrfInput() }}
      {{ actionInput('yesterdays-news/cp/sync') }}
      {{ redirectInput(craft.app.request.url) }}
      <button type="submit" class="btn{{ not blitzIsInstalled ? ' disabled' }}"{% if not blitzIsInstalled %} disabled{% endif %}>Sync from Blitz</button>
    </form>

    <form method="post" class="yn-actions__clear">
      {{ csrfInput() }}
      {{ actionInput('yesterdays-news/cp/clear') }}
      {{ redirectInput(craft.app.request.url) }}
      <button type="submit" class="btn yn-danger"
        onclick="return confirm('Clear all Yesterday\'s News visit data? This cannot be undone.')">
        Clear all data
      </button>
    </form>

  </div>

  {# ── Settings — plugin-wide config, not scoped to a site ─────────── #}
  <div class="yn-meta">
    <div class="yn-meta__group">
      <span class="yn-meta__label">Settings</span>

      <span>
        Page threshold: <strong>{{ thresholdHuman }}</strong>
        <span class="info">Pages that have been visited <strong>{{ lowVisitCount }} or more times</strong> and haven't been visited in the last <strong>{{ thresholdHuman }}</strong> will be marked as stale and removed from the Blitz cache on the next prune run.</span>
      </span>

      {% if pagePruningEnabled %}
        <span>
          Low-visit threshold: <strong>{{ lowVisitThresholdHuman }}</strong> <span class="yn-muted">(< {{ lowVisitCount }} visit{{ lowVisitCount != 1 ? 's' }})</span>
          <span class="info">Pages visited fewer than <strong>{{ lowVisitCount }} time{{ lowVisitCount != 1 ? 's' }}</strong> that haven't been visited in the last <strong>{{ lowVisitThresholdHuman }}</strong> will be marked as stale. This catches bot-crawled pages that never generate real beacon pings.</span>
        </span>
      {% endif %}
    </div>
  </div>

  <hr class="yn-divider">

  {# ── Site switcher — native Craft dropdown, same as Blitz's own diagnostics
       utility. Scopes everything below (the report), not the actions above ── #}
  <div class="yn-sitemenu">
    {% include '_elements/sitemenu' with {
      selectedSiteId: siteId,
      urlFormat: 'utilities/yesterdays-news-diagnostics?site={handle}',
    } only %}
  </div>

  {# ── Page visits summary — scoped to the selected site ───────────── #}
  {% set lowVisitPageCount  = rows|filter(r => r.isLowVisit)|length %}
  {% set normalVisitPageCount = totalCount - lowVisitPageCount %}

  <div class="yn-meta">
    <div class="yn-meta__group">
      <span class="yn-meta__label">Stats</span>

      <span><strong>{{ totalCount }}</strong> tracked</span>

      {% if totalCount > 0 %}
        <span class="yn-stale">
          <strong>{{ staleCount }}</strong> stale
          <span class="yn-muted">({{ ((staleCount / totalCount) * 100)|round }}%)</span>
        </span>
        <span class="yn-fresh">
          <strong>{{ freshCount }}</strong> fresh
          <span class="yn-muted">({{ ((freshCount / totalCount) * 100)|round }}%)</span>
        </span>
        <span>
          <strong>{{ lowVisitPageCount }}</strong> low-visit
          <span class="yn-muted">({{ ((lowVisitPageCount / totalCount) * 100)|round }}%)</span>
        </span>
        <span>
          <strong>{{ normalVisitPageCount }}</strong> normal-visit
          <span class="yn-muted">({{ ((normalVisitPageCount / totalCount) * 100)|round }}%)</span>
        </span>
      {% endif %}

      {% if pendingCount > 0 %}
        <span class="yn-buffered"><strong>{{ pendingCount }}</strong> buffered</span>
      {% endif %}
    </div>
  </div>

  {# ── Page visits table ─────────────────────────────────────────── #}
  {% if rows is empty %}
    <p class="zilch">No visits recorded yet.</p>
  {% else %}
    <div class="tableview">
      <table class="data fullwidth yn-table">
        <thead>
          <tr>
            <th class="thin yn-col-status"><!--status--></th>
            <th>URL</th>
            <th class="yn-nowrap">Last visited <small>UTC</small></th>
            <th class="yn-nowrap">Age</th>
            <th class="yn-nowrap">Visits</th>
            <th class="yn-nowrap">Action</th>
          </tr>
        </thead>
        <tbody>
          {% for row in rows %}
            <tr class="{{ row.isStale ? 'yn-stale' : 'yn-fresh' }}">
              <td class="yn-col-status">
                {% if row.isStale %}
                  <span class="status off" title="Scheduled for pruning"></span>
                {% else %}
                  <span class="status on" title="Staying in cache"></span>
                {% endif %}
              </td>
              <td><code>{{ row.url }}</code></td>
              <td class="yn-date">{{ row.lastVisitedAt|slice(0, 16) }}</td>
              <td class="yn-nowrap">{{ row.ageHuman }}</td>
              <td class="yn-nowrap">
                {{ row.visitCount }}
                {% if row.isLowVisit %}
                  <span class="yn-muted" title="Low-visit — using {{ lowVisitThresholdHuman }} threshold">↓</span>
                {% endif %}
              </td>
              <td class="yn-nowrap">
                {% if row.isStale %}
                  <span class="yn-stale">Prune on next run</span>
                {% else %}
                  <span class="yn-muted">Keep for {{ row.pruneInHuman }}</span>
                {% endif %}
              </td>
            </tr>
          {% endfor %}
        </tbody>
      </table>
    </div>
  {% endif %}

  {# ── Cached includes ───────────────────────────────────────────── #}
  {% if includeTotalCount is defined %}
    <h3 class="yn-heading">
      Cached Includes
      <span class="yn-heading__subtitle">
        — {{ includeTotalCount }} tracked,
        <span class="yn-stale">{{ includeReadyCount }} ready to prune</span>
      </span>
    </h3>

    <p class="yn-desc">
      Pruned when entry age &gt; {{ (entryAgeThreshold / 86400)|round(0) }}d
      <em>and</em> cache age &gt; {{ (includeThreshold / 3600)|round(0) }}h.
      New/recently-updated entries are never pruned regardless of cache age.
    </p>

    {% if includeRows is empty %}
      <p class="zilch">No cached includes found for the configured templates.</p>
    {% else %}
      <div class="tableview">
        <table class="data fullwidth yn-table">
          <thead>
            <tr>
              <th class="thin yn-col-status"><!--status--></th>
              <th>Template</th>
              <th class="yn-nowrap">Entry ID</th>
              <th class="yn-nowrap">Entry age</th>
              <th class="yn-nowrap">Cache age</th>
              <th class="yn-nowrap">Status</th>
            </tr>
          </thead>
          <tbody>
            {% for row in includeRows %}
              <tr>
                <td class="yn-col-status">
                  {% if row.isReadyToPrune %}
                    <span class="status off" title="Ready to prune"></span>
                  {% elseif row.dateCached is null %}
                    <span class="status yn-status-unknown" title="Not in blitz_caches"></span>
                  {% else %}
                    <span class="status on" title="Waiting"></span>
                  {% endif %}
                </td>

                <td>
                  <code>{{ row.template }}</code>
                </td>

                <td class="yn-nowrap">
                  {{ row.entryId }}
                </td>

                <td class="yn-nowrap">
                  {% if row.entryAgeHuman %}
                    <span{% if not row.isEntryOld %} class="yn-fresh" title="Entry updated recently — protected"{% endif %}>
                      {{ row.entryAgeHuman }}
                    </span>
                  {% else %}
                    <span class="yn-muted">unknown</span>
                  {% endif %}
                </td>

                <td class="yn-nowrap">
                  {% if row.cacheAgeHuman %}
                    {{ row.cacheAgeHuman }}
                  {% else %}
                    <span class="yn-muted">not cached</span>
                  {% endif %}
                </td>

                <td class="yn-nowrap">
                  {% if row.isReadyToPrune %}
                    <span class="yn-stale">Prune on next run</span>
                  {% elseif row.dateCached is null %}
                    <span class="yn-muted">Not cached</span>
                  {% elseif not row.isEntryOld %}
                    <span class="yn-fresh">Entry too new</span>
                  {% elseif not row.isCacheOld %}
                    <span class="yn-muted">Cache too fresh</span>
                  {% endif %}
                </td>
              </tr>
            {% endfor %}
          </tbody>
        </table>
      </div>
    {% endif %}
  {% endif %}

</div>
